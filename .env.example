# ─────────────────────────────────────────────────────────────────────────────
# Service
# ─────────────────────────────────────────────────────────────────────────────
SERVICE_NAME=rule-based-server
SERVICE_VERSION=1.0.0
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Comma-separated origins. Use "*" only in development.
CORS_ORIGINS=*

# Cap on JSON/URL-encoded body size (Express ms-format string).
BODY_LIMIT=256kb

# ─────────────────────────────────────────────────────────────────────────────
# Detection pipeline
# ─────────────────────────────────────────────────────────────────────────────
# Hard budget for the whole detection pipeline (ms). When exceeded the
# fallback decision is applied immediately, mirroring an SLA-protected
# production system.
DETECTION_BUDGET_MS=50

# Decision when the budget is blown: allow | block.
FALLBACK_DECISION=allow

# Default mode if the request does not override it via X-Detection-Mode.
# rule | ai | hybrid
DETECTION_MODE=hybrid

# When true, the simulation panel can override mode/budget/run-id/ground-truth
# per request via headers. Disable in real production.
ALLOW_HEADER_OVERRIDES=true

# ─────────────────────────────────────────────────────────────────────────────
# Rule engine
# ─────────────────────────────────────────────────────────────────────────────
# any      = block if any rule fires
# weighted = block if sum(weight of fired rules) >= RULE_SCORE_THRESHOLD
RULE_AGGREGATION=any
RULE_SCORE_THRESHOLD=1.0

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
BURST_WINDOW_MS=1000
BURST_MAX=15

BRUTE_FORCE_WINDOW_MS=60000
BRUTE_FORCE_MAX_FAILS=5

SCAN_WINDOW_MS=10000
SCAN_DISTINCT_PATHS=10

MAX_PAYLOAD_BYTES=51200
IP_BLOCKLIST=

# ─────────────────────────────────────────────────────────────────────────────
# AI-based server (downstream)
# ─────────────────────────────────────────────────────────────────────────────
AI_SERVER_URL=http://127.0.0.1:8000
AI_SERVER_TIMEOUT_MS=200
AI_SCORE_THRESHOLD=0.5
AI_CB_FAILURE_THRESHOLD=5
AI_CB_OPEN_MS=10000

# ─────────────────────────────────────────────────────────────────────────────
# Metrics (JSONL output)
# ─────────────────────────────────────────────────────────────────────────────
METRICS_ENABLED=true
METRICS_DIR=./metrics/runs
METRICS_FLUSH_INTERVAL_MS=1000
METRICS_MAX_RECORDS_PER_RUN=0
# When unset, a timestamped run id is generated at startup.
RUN_ID=
# In production, deletion is disabled unless this is explicitly set.
METRICS_ALLOW_DELETE=0
